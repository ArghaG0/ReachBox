NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
DATABASE_URL=postgresql://reachbox:reachbox_local_only@localhost:5432/reachbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# OAuth integration is implemented in later phases. Leave credentials blank for now.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
BULL_BOARD_USER=
BULL_BOARD_PASS=

WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_QUEUE_NAME=emails
QUEUE_PREFIX=reachbox
QUEUE_BULK_SIZE=500
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=1000
COMPLETED_JOB_RETENTION_SECONDS=3600
MAX_RECIPIENTS=5000
MAX_SUBJECT_CHARS=998
MAX_BODY_CHARS=1000000
HTTP_BODY_LIMIT_BYTES=2000000
DATABASE_TRANSACTION_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
STALE_CLAIM_MS=120000
SMTP_SEND_TIMEOUT_MS=60000
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=2
RECONCILIATION_BATCH_SIZE=200
SHUTDOWN_TIMEOUT_MS=90000
RATE_KEY_TTL_SECONDS=7200
SLACK_DEBOUNCE_SECONDS=3600
SEED_SENDER_COUNT=2
SEED_USER_ID=
