generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  googleId        String           @unique
  email           String           @unique
  name            String
  avatarUrl       String           @default("")
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  senders         Sender[]
  campaigns       Campaign[]
  emails          Email[]
  slackConnection SlackConnection?
}

model Sender {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id])
  email     String
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  campaigns Campaign[]
  emails    Email[]

  @@index([userId])
}

model Campaign {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  senderId     String   @db.Uuid
  sender       Sender   @relation(fields: [senderId], references: [id])
  subject      String
  bodyHtml     String
  startAt      DateTime @db.Timestamptz(3)
  delaySeconds Float
  hourlyLimit  Int
  total        Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  emails       Email[]

  @@index([userId])
  @@index([senderId])
}

model Email {
  id          String      @id @default(uuid()) @db.Uuid
  campaignId  String      @db.Uuid
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id])
  senderId    String      @db.Uuid
  sender      Sender      @relation(fields: [senderId], references: [id])
  toEmail     String
  subject     String
  bodyHtml    String
  scheduledAt DateTime    @db.Timestamptz(3)
  status      EmailStatus @default(scheduled)
  sentAt      DateTime?   @db.Timestamptz(3)
  attempts    Int         @default(0)
  failedAttempts Int      @default(0)
  error       String?
  messageId   String?
  previewUrl  String?
  jobId       String      @unique
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId, status, scheduledAt])
  @@index([senderId, status])
  @@index([status, updatedAt])
  @@index([campaignId])
}

model SlackConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  teamName    String
  channelName String
  webhookUrl  String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}
